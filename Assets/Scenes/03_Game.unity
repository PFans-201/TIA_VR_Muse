  m_Script: {fileID: 11500000, guid: bdcb7a13e548fb64cbc95270253f6da4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DifficultyUI
  progressionMode: 0
  difficultyPanel: {fileID: 779119488}
  easyButton: {fileID: 1920534804}
  mediumButton: {fileID: 433233779}
  hardButton: {fileID: 1983297893}
  easyInfoButton: {fileID: 2104478438}
  mediumInfoButton: {fileID: 1954375767}
  hardInfoButton: {fileID: 1063574449}
  infoCloseButton: {fileID: 1186180171}
  infoPanel: {fileID: 1695077838}
  infoTitle: {fileID: 1487761687}
  infoBody: {fileID: 111634409}
  easyInfoTitle: "EASY \u2014 5 pieces"
  easyInfoBody: "Bright, well-lit room.\n\nPieces start right next to their slots
    and a strong magnet pulls each one in \u2014 it even snaps home while you're
    still holding it. The gentlest mode."
  mediumInfoTitle: "MEDIUM \u2014 12 pieces"
  mediumInfoBody: "The room goes dark \u2014 grab the floating lantern (it clips
    to your arm) to search.\n\nPieces are spread further from their slots and the
    magnet is lighter, so you place them more deliberately.\n\nIf you get stressed
    or stuck on a piece, it and its slot glow the same colour and the lantern cone
    widens to help you."
  hardInfoTitle: "HARD \u2014 22 pieces"
  hardInfoBody: "Dark room filled with walls, columns and baskets.\n\nPieces rain
    down from the ceiling and settle among the obstacles. The magnet is weak \u2014
    this is mostly hand placement.\n\nWhen you're stressed or stuck: a piece and
    its slot glow the same colour, the lantern cone widens, and a long-lost piece
    flickers so you can find it."
  statusLabel: {fileID: 1210762561}
  puzzleManager: {fileID: 934991162}
